# Copy appropriate values to backend/.env for local development.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/codeconnect_dev
JWT_SECRET=replace-with-at-least-32-random-characters
MESSAGE_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
ADMIN_USERNAME=change_me
ADMIN_PASSWORD=replace-with-a-strong-password
CLIENT_ORIGIN=http://localhost:5713
COOKIE_SECURE=false
TRUST_PROXY=false
DNS_SERVERS=
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Frontend development only. Production uses same-origin API and Socket.IO.
VITE_BACKEND_URL=http://localhost:5000
