# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local MongoDB:      mongodb://127.0.0.1:27017/codeconnect
# MongoDB Atlas:      mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/codeconnect
MONGODB_URI=mongodb://127.0.0.1:27017/codeconnect

# ---- Secrets ----
JWT_SECRET=replace-with-at-least-32-random-characters
MESSAGE_ENCRYPTION_KEY=replace-with-64-hex-characters

# ---- First admin account ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# ---- URLs & CORS ----
VITE_BACKEND_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=false
DNS_SERVERS=
